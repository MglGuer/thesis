@article{nunez_cultural_2024,
	title = {Cultural {Values} in {Leadership} {Practices} of {Filipino} {Teacher}-{Leaders} in {South} {Central} {Maryland}: {Input} for {Transformational} {Leadership} {Framework}},
	volume = {10},
	copyright = {Copyright (c) 2024 AIDE Interdisciplinary Research Journal},
	issn = {2960-365X},
	shorttitle = {Cultural {Values} in {Leadership} {Practices} of {Filipino} {Teacher}-{Leaders} in {South} {Central} {Maryland}},
	url = {https://journal.aide-inc.net/index.php/aide-irj/article/view/150},
	doi = {10.56648/aide-irj.v10i1.150},
	abstract = {Existing transformational leadership frameworks often lack cultural alignment with Filipino values, creating a gap for Filipino teacher-leaders who seek leadership framework that resonate with their cultural identity. This study addresses this need by examining the influence of Filipino cultural values on the leadership practices of Filipino teacher-leaders in South Central Maryland. Quantitative findings indicate that values such as Hiya (Shame), Close Family Ties, Pakikisama (Interdependence), Utang na Loob (Debt reciprocity), and Bahala Na (Resilience or trust in fate) have a very high influence on leadership practices, with Hiya being the most influential. Qualitative analysis reveals two primary themes: People-Oriented Leadership and Organizational Inclusivity \& Harmony, reflecting a leadership style that emphasizes ethical integrity, collaboration, and resilience within a supportive and cohesive school environment. The study also highlights specific benefits, including enhanced accountability, collaboration, and resilience. Challenges arise when cultural values sometimes conflict with organizational expectations, particularly in objective decision-making and strategic planning. To address these conflicts, teacher-leaders employ coping strategies such as promoting professional boundaries, encouraging participative feedback, balancing flexibility with proactive planning, and maintaining organizational responsibility. Together, these findings support a culturally tailored approach to transformational leadership that upholds Filipino values while adapting to educational demands. To effectively integrate these cultural values into leadership, the study suggests embedding the framework into educational training programs, community presentations, and continuous feedback mechanisms to sustain culturally resonant leadership.},
	language = {en},
	urldate = {2025-07-06},
	journal = {AIDE Interdisciplinary Research Journal},
	author = {Nunez, Alona L.},
	month = nov,
	year = {2024},
	keywords = {Filipino cultural values, inclusivity, mixed-method research design, people-oriented leadership, Philippines, teacher-leaders, transformational leadership},
	pages = {1--24},
	file = {Full Text PDF:C\:\\Users\\Renzel\\Zotero\\storage\\3UA7NC5N\\Nunez - 2024 - Cultural Values in Leadership Practices of Filipino Teacher-Leaders in South Central Maryland Input.pdf:application/pdf},
}

